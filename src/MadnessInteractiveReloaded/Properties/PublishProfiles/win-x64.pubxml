<?xml version="1.0" encoding="utf-8"?>
<!--
Self-contained Windows x64 publish, so players don't need the .NET runtime installed (BUG-97).
Use it with: dotnet publish src/MadnessInteractiveReloaded/MIR.csproj -c Release -r win-x64 (plus the self-contained switch) -p:PublishProfile=win-x64 -o FOLDER
The PostPublish target in MIR.csproj then packs base.waa into the publish folder, using the freshly published IIR.exe (so it needs a Windows host).
Not single-file, because the native libraries (OpenAL, ffmpeg, nfd) have to sit next to the exe as separate files. Not trimmed, because the game loads assemblies and scripts by reflection.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\Release\net9.0\win-x64\publish\</PublishDir>
  </PropertyGroup>
</Project>
